TANDEM_NETWORK=regtest
TANDEM_INIT_TXID=replace_with_64_lowercase_hex
TANDEM_SPEC_PATH=/protocol/tandem-v1.md
TANDEM_SPEC_SHA256=912e8ebad7eeb40c86734724962e4c8b9ba27d248600ff93fcb2b5bf9efc2167
DATABASE_URL=postgresql://replace_user:replace_password@postgres:5432/tandem
BITCOIN_RPC_URL=http://host.docker.internal:18443
BITCOIN_RPC_USER=replace_rpc_user
BITCOIN_RPC_PASSWORD=replace_rpc_password
TANDEM_BIND_ADDR=0.0.0.0:8088
TANDEM_SIGNING_KEY_FILE=/run/secrets/tandem_ed25519_seed
TANDEM_SIGNING_KEY_ID=replace-key-id
TANDEM_PARSER_COMMIT=replace_with_40_lowercase_hex
TANDEM_INDEXER_COMMIT=replace_with_40_lowercase_hex
TANDEM_PARSER_BINARY_SHA256=replace_with_64_lowercase_hex
TANDEM_INDEXER_BINARY_SHA256=replace_with_64_lowercase_hex
TANDEM_POLL_INTERVAL_MS=5000
TANDEM_ALLOW_MAINNET=false
